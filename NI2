-- Background monitor for Trial State & AutoTrial execution
task.spawn(function()
    while task.wait(0.1) do
        updateAutoPauseState()
        if not autoTrialOn then continue end

        local trialsStatus = RS:FindFirstChild("TrialsStatus")
        local entryOpen = trialsStatus and trialsStatus:FindFirstChild("EntryOpen")
        local trialsRoot = getTrialsRoot()

        -- Auto Enter Trial Door
        if entryOpen and entryOpen.Value == true and not TrialActive and trialsRoot then
            local trialRoom = trialsRoot:FindFirstChild(SelectedTrialDifficulty .. "TrialRoom")
                or trialsRoot:FindFirstChild("__Trial" .. SelectedTrialDifficulty .. "Room")
                or trialsRoot:FindFirstChild(SelectedTrialDifficulty)

            local touchPart = trialRoom and (
                trialRoom:FindFirstChild("TouchPart", true)
                or (trialRoom:IsA("BasePart") and trialRoom)
                or trialRoom:FindFirstChild("Handle", true)
            )

            if touchPart then
                local root = getRoot()
                if root then
                    root.CFrame = touchPart.CFrame
                    task.wait(0.3)
                end
            end
        end

        -- Inside Trial
        if TrialActive then
            local trialStatusDiff = trialsStatus and trialsStatus:FindFirstChild(SelectedTrialDifficulty)
            local timeLeftObj = trialStatusDiff and trialStatusDiff:FindFirstChild("TimeLeft")

            if timeLeftObj and autoLeaveEnabled and timeLeftObj.Value > 0 and timeLeftObj.Value <= leaveTime then
                leaveTrial()
                repeat
                    task.wait(0.2)
                    updateAutoPauseState()
                until not TrialActive or not autoTrialOn
                continue
            end

            local trialRoom = trialsRoot and (
                trialsRoot:FindFirstChild(SelectedTrialDifficulty .. "TrialRoom")
                or trialsRoot:FindFirstChild("__Trial" .. SelectedTrialDifficulty .. "Room")
                or trialsRoot:FindFirstChild(SelectedTrialDifficulty)
            )

            local mobsFolder = trialRoom and (
                trialRoom:FindFirstChild("Mobs")
                or trialRoom:FindFirstChild("MobsFolder")
                or trialRoom:FindFirstChild("Entities")
            )

            if mobsFolder and getRoot() then
                local mode = normalizeMode(MovementMode)

                if mode == "Legit" then
                    for _, mob in ipairs(mobsFolder:GetChildren()) do
                        if not autoTrialOn or not TrialActive then break end
                        local cf = getTargetCFrame(mob)
                        if cf then
                            moveTo(cf, nil, true)
                            task.wait(0.1)
                        end
                    end
                else
                    local closestMob = getClosest(mobsFolder, isAlive)
                    if closestMob then
                        local cf = getTargetCFrame(closestMob)
                        if cf then
                            moveTo(cf, function()
                                return isAlive(closestMob)
                            end, true)
                        end
                    end
                end
            end
        end
    end
end)

