local suffixes = {
    k = 1e3, M = 1e6, B = 1e9, T = 1e12,
    Qd = 1e15, Qn = 1e18, Sx = 1e21, Sp = 1e24,
    Oc = 1e27, No = 1e30,
    De = 1e33, UDe = 1e36, DDe = 1e39, TDe = 1e42,
    QdDe = 1e45, QnDe = 1e48, SxDe = 1e51, SpDe = 1e54,
    OcDe = 1e57, NoDe = 1e60,
    Vt = 1e63, UVt = 1e66, DVt = 1e69, TVt = 1e72,
    QdVt = 1e75, QnVt = 1e78, SxVt = 1e81, SpVt = 1e84,
    OcVt = 1e87, NoVt = 1e90,
    Tg = 1e93, UTg = 1e96, DTg = 1e99, TTg = 1e102,
    QdTg = 1e105, QnTg = 1e108, SxTg = 1e111, SpTg = 1e114,
    OcTg = 1e117, NoTg = 1e120,
}

local function parseNumber(str)
    if not str then return 0 end
    local n = tonumber(str)
    if n then return n end
    local base, suf = tostring(str):match("([%d%.]+)(%a+)")
    if base and suf and suffixes[suf] then
        return (tonumber(base) or 0) * suffixes[suf]
    end
    return 0
end

local function readCurrencyAmount(currencyObj)
    if not currencyObj then return 0 end
    local amtObj = currencyObj:FindFirstChild("Amount")
    local child = amtObj and (amtObj:FindFirstChild("1") or amtObj:FindFirstChildOfClass("StringValue") or amtObj:FindFirstChildOfClass("NumberValue"))
    return child and parseNumber(child.Value or child.Text) or 0
end

local function readUpgradeCost(upgradeUI)
    local costFrame = upgradeUI and upgradeUI:FindFirstChild("Cost")
    local amtObj = costFrame and costFrame:FindFirstChild("Amount")
    return amtObj and parseNumber(amtObj.Text) or 0
end

local function getUpgradeBoards()
    local boards = {}
    if WorldUI then
        for _, ui in ipairs(WorldUI:GetChildren()) do
            if ui.Name:match("^Upgrades%.%.") then
                boards[ui.Name:gsub("^Upgrades%.%.", "")] = ui
            end
        end
    end
    return boards
end

local UpgradeBoards = getUpgradeBoards()

-- Fixed: Populates upgrade list even when board.Main.Visible is false
local function getUpgradeList(board)
    local list = {}
    local main = board and board:FindFirstChild("Main")
    if not main then return list end
    for _, child in ipairs(main:GetChildren()) do
        if child:IsA("Frame") and child.Name ~= "Filler" then
            table.insert(list, child.Name)
        end
    end
    table.sort(list)
    return list
end

local function startAutoBuy(currency)
    startManagedThread("AutoBuy_" .. currency, function()
        while getgenv()[currency .. "_AutoBuy"] do
            task.wait(0.25)

            local selected = SelectedUpgrades[currency]
            if not selected or #selected == 0 then continue end

            local board = UpgradeBoards[currency] or (WorldUI and WorldUI:FindFirstChild("Upgrades.." .. currency))
            UpgradeBoards[currency] = board

            local currenciesFolder = LocalPlayer:FindFirstChild("CURRENCIES")
            local currencyObj = currenciesFolder and currenciesFolder:FindFirstChild(currency)
            local amount = readCurrencyAmount(currencyObj)
            local remote = getMainRemote()

            if remote and board and board:FindFirstChild("Main") then
                for _, upgradeName in ipairs(selected) do
                    if upgradeName ~= "None" then
                        local upgradeUI = board.Main:FindFirstChild(upgradeName)
                        if upgradeUI then
                            local cost = readUpgradeCost(upgradeUI)
                            if amount >= cost then
                                remote:FireServer("UpgradeUpgrade", currency, upgradeName)
                            end
                        end
                    end
                end
            end
        end
    end)
end

