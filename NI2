local function applyFlags(data)
    for flagName, value in pairs(data) do
        local element = Rayfield.Flags[flagName]
        if element then
            if type(value) == "table" then
                if #value == 0 then
                    value = ""
                elseif #value == 1 then
                    value = value[1]
                end
            end

            if element.Set then
                pcall(element.Set, element, value)
            elseif element.SetValue then
                pcall(element.SetValue, element, value)
            end
        end
    end
end

local function getConfigs()
    if not listfiles then return {} end
    local ok, files = pcall(listfiles, ConfigFolder)
    if not ok or type(files) ~= "table" then return {} end

    local names = {}
    for _, file in ipairs(files) do
        local clean = file:match("([^/\\]+)%.json$")
        if clean then
            table.insert(names, clean)
        end
    end
    table.sort(names)
    return names
end

