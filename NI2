AutoOresTab:CreateToggle({
    Name = "Farm All Ores",
    Flag = "FarmAllOres",
    CurrentValue = false,
    Callback = function(state)
        farmAllOresOn = state
        movementCancelled = not state
        if not state then
            stopManagedThread("FarmAllOres")
            return
        end

        startManagedThread("FarmAllOres", function()
            local currentGroupName = nil

            while farmAllOresOn do
                if AutosPaused or not getRoot() or not OresFolder then
                    task.wait(0.15)
                    continue
                end

                local groups = {}
                for _, ore in ipairs(OresFolder:GetChildren()) do
                    groups[ore.Name] = groups[ore.Name] or {}
                    table.insert(groups[ore.Name], ore)
                end

                if not currentGroupName or not groups[currentGroupName] then
                    local names = {}
                    for name in pairs(groups) do table.insert(names, name) end
                    currentGroupName = (#names > 0) and names[math.random(#names)] or nil
                end

                local group = currentGroupName and groups[currentGroupName]
                if not group then
                    task.wait(0.1)
                    continue
                end

                local farmedAny = false
                for _, ore in ipairs(group) do
                    if not farmAllOresOn or AutosPaused then break end
                    if isAlive(ore) then
                        farmedAny = true
                        local cf = getTargetCFrame(ore)
                        if cf then
                            moveTo(cf, function() return isAlive(ore) end)
                        end
                    end
                end

                if not farmedAny then
                    currentGroupName = nil
                end

                task.wait(0.05)
            end
        end)
    end
})

