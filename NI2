local function normalizeMode(mode)
    return typeof(mode) == "table" and mode[1] or mode
end

local function normalizeSelection(v)
    return typeof(v) == "table" and v[1] or v
end

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getCleanName(name)
    return name:match("^(.-)#?%d*$") or name
end

local function isPlayerInTrial()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local hud = pg and pg:FindFirstChild("HUD")
    local leaveButton = hud and hud:FindFirstChild("LeaveTrial", true)
    if leaveButton and leaveButton.Visible then
        return true
    end

    local ts = RS:FindFirstChild("TrialsStatus")
    if ts then
        local diff = ts:FindFirstChild(SelectedTrialDifficulty)
        local inTrial = diff and diff:FindFirstChild("InTrial")
        if inTrial and inTrial.Value == true then
            return true
        end
    end

    return false
end

local function updateAutoPauseState()
    TrialActive = isPlayerInTrial()
    AutosPaused = TrialActive
end

local function getHP(obj)
    if not obj or not obj.Parent then return 0 end
    local ui = obj:FindFirstChild("OresTopUI") or obj:FindFirstChild("MobsTopUI") or obj:FindFirstChild("UI")
    local bar = ui and ui:FindFirstChild("Bar")
    local hpLabel = bar and bar:FindFirstChild("Health")
    if not hpLabel then return 0 end

    local raw = tostring(hpLabel.Text)
    local slashPos = raw:find("/")
    if not slashPos then return 0 end

    local left = raw:sub(1, slashPos - 1):gsub("%s+", "")
    local num = tonumber(left)
    if num then return num end
    return (left ~= "0" and left ~= "") and 1 or 0
end

local function isAlive(obj)
    return getHP(obj) > 0
end

local function leaveTrial()
    local remote = getMainRemote()
    if remote then
        remote:FireServer("LeaveTrial")
    end
end

local function getTargetCFrame(obj)
    if not obj then return nil end
    if obj:IsA("Model") then
        local specificPart = obj:FindFirstChild("TouchPart") or obj:FindFirstChild("Handle")
        if specificPart and specificPart:IsA("BasePart") then
            return specificPart.CFrame
        end
        local ok, pivot = pcall(obj.GetPivot, obj)
        if ok then return pivot end
    elseif obj:IsA("BasePart") then
        return obj.CFrame
    end
    return nil
end

---------------------------------------------------------------------
-- Optimized Movement & Target Acquisition
---------------------------------------------------------------------
local function moveTo(cframe, aliveCheckFn, ignorePause)
    if not cframe then return end
    if AutosPaused and not ignorePause then return end

    movementCancelled = false
    local mode = normalizeMode(MovementMode)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChild("Humanoid")
    if not root or not humanoid then return end

    if mode == "Teleport" then
        root.CFrame = cframe
        return
    end

    if mode == "Tween" then
        local distance = (root.Position - cframe.Position).Magnitude
        local duration = math.max(distance / 60, 0.05)
        local tween = TweenService:Create(
            root,
            TweenInfo.new(duration, Enum.EasingStyle.Linear),
            { CFrame = cframe }
        )
        tween:Play()
        while tween.PlaybackState == Enum.PlaybackState.Playing do
            if movementCancelled or (AutosPaused and not ignorePause) then
                tween:Cancel()
                return
            end
            if mode ~= "Legit" and aliveCheckFn and not aliveCheckFn() then
                tween:Cancel()
                return
            end
            task.wait(0.05)
        end
        return
    end

    -- Walk / Legit Mode (Fixed stuckTimer reset bug)
    local targetPos = cframe.Position
    humanoid:MoveTo(targetPos)
    local reached = false
    local connection
    connection = humanoid.MoveToFinished:Connect(function()
        reached = true
    end)

    local lastPos = root.Position
    local stuckTimer = 0
    local hasJumped = false

    while not reached do
        task.wait(0.05)
        if movementCancelled or (AutosPaused and not ignorePause) then
            connection:Disconnect()
            return
        end
        if mode ~= "Legit" and aliveCheckFn and not aliveCheckFn() then
            connection:Disconnect()
            return
        end

        local currentPos = root.Position
        local distMoved = (currentPos - lastPos).Magnitude
        lastPos = currentPos

        if distMoved < 0.08 then
            stuckTimer += 0.05
        else
            stuckTimer = 0
            hasJumped = false
        end

        if stuckTimer > 0.6 and not hasJumped then
            hasJumped = true
            humanoid.Jump = true
            humanoid:MoveTo(targetPos)
        elseif stuckTimer > 1.2 then
            root.CFrame = cframe + Vector3.new(0, 0.3, 0)
            break
        end
    end

    connection:Disconnect()
end

-- Checks distance BEFORE running expensive UI/String health checks
local function getClosest(folder, filterFn)
    local root = getRoot()
    if not root or not folder then return nil end

    local rootPos = root.Position
    local best, bestDist

    for _, obj in ipairs(folder:GetChildren()) do
        local cf = getTargetCFrame(obj)
        if cf then
            local dist = (rootPos - cf.Position).Magnitude
            if not bestDist or dist < bestDist then
                if filterFn(obj) then
                    bestDist = dist
                    best = obj
                end
            end
        end
    end

    return best
end

---------------------------------------------------------------------
-- Debounced Lists & Auto-Refresh
---------------------------------------------------------------------
local oreRefreshQueued = false
local mobRefreshQueued = false
local capsuleRefreshQueued = false
local runeRefreshQueued = false

local function refreshOreList()
    local seen, list = {}, {}
    if OresFolder then
        for _, ore in ipairs(OresFolder:GetChildren()) do
            local clean = getCleanName(ore.Name)
            if not seen[clean] then
                seen[clean] = true
                table.insert(list, clean)
            end
        end
    end
    table.sort(list)
    if not tablesEqual(OreList, list) then
        OreList = list
        if OreDropdown then OreDropdown:Refresh(ensureNotEmpty(list)) end
    end
end

local function queueOreRefresh()
    if oreRefreshQueued then return end
    oreRefreshQueued = true
    task.delay(1.5, function()
        oreRefreshQueued = false
        refreshOreList()
    end)
end

local function refreshMobList()
    local seen, list = {}, {}
    if MobsFolder then
        for _, mob in ipairs(MobsFolder:GetChildren()) do
            local clean = getCleanName(mob.Name)
            if not seen[clean] then
                seen[clean] = true
                table.insert(list, clean)
            end
        end
    end
    table.sort(list)
    if not tablesEqual(MobList, list) then
        MobList = list
        if MobDropdown then MobDropdown:Refresh(ensureNotEmpty(list)) end
    end
end

local function queueMobRefresh()
    if mobRefreshQueued then return end
    mobRefreshQueued = true
    task.delay(1.5, function()
        mobRefreshQueued = false
        refreshMobList()
    end)
end

local function refreshCapsuleList()
    local list, map = {}, {}
    if UIZones then
        for _, child in ipairs(UIZones:GetChildren()) do
            if child.Name:find("__Capsule") then
                local display = child.Name:gsub("__Capsule", "")
                if display == "" then display = "Default" end
                table.insert(list, display)
                map[display] = child.Name
            end
        end
    end
    table.sort(list)
    capsuleDisplayMap = map
    if not tablesEqual(capsuleOptions, list) then
        capsuleOptions = list
        if CapsuleDropdown then CapsuleDropdown:Refresh(ensureNotEmpty(list)) end
    end
end

local function queueCapsuleRefresh()
    if capsuleRefreshQueued then return end
    capsuleRefreshQueued = true
    task.delay(1.5, function()
        capsuleRefreshQueued = false
        refreshCapsuleList()
    end)
end

local function refreshRuneList()
    local list = {}
    if RuneZones then
        for _, child in ipairs(RuneZones:GetChildren()) do
            table.insert(list, child.Name)
        end
    end
    table.sort(list)
    if not tablesEqual(runeOptions, list) then
        runeOptions = list
        if RuneDropdown then RuneDropdown:Refresh(ensureNotEmpty(list)) end
    end
end

local function queueRuneRefresh()
    if runeRefreshQueued then return end
    runeRefreshQueued = true
    task.delay(1.5, function()
        runeRefreshQueued = false
        refreshRuneList()
    end)
end

