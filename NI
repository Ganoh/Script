-- Dynamic Trials Location Finder
local function getTrialsRoot()
    if not GameContent then return nil end

    -- Primary path: __GAME_CONTENT.Contents["WORLD - 3"].Trials
    local contents = GameContent:FindFirstChild("Contents")
    local world3 = contents and contents:FindFirstChild("WORLD - 3")
    if world3 and world3:FindFirstChild("Trials") then
        return world3.Trials
    end

    -- Fallback: Search any world in Contents
    if contents then
        for _, child in ipairs(contents:GetChildren()) do
            if child:FindFirstChild("Trials") then
                return child.Trials
            end
        end
    end

    -- Fallback: Root of GameContent
    return GameContent:FindFirstChild("Trials")
end

