                updateAutoPauseState()
                if AutosPaused then task.wait(0.1) continue end

                local ritualPart = workspace:FindFirstChild("__GAME_CONTENT")
                    and workspace.__GAME_CONTENT:FindFirstChild("Contents")
                    and workspace.__GAME_CONTENT.Contents:FindFirstChild("WORLD - 3")
                    and workspace.__GAME_CONTENT.Contents["WORLD - 3"]:FindFirstChild("RitualChamberModel")
                    and workspace.__GAME_CONTENT.Contents["WORLD - 3"].RitualChamberModel:FindFirstChild("MainPart")

                local timerObj = ritualPart
                    and ritualPart:FindFirstChild("SurfaceGui")
                    and ritualPart.SurfaceGui:FindFirstChild("Bar")
                    and ritualPart.SurfaceGui.Bar:FindFirstChild("Timer")

                if not (timerObj and timerObj.Text == "Start ritual!") then
                    task.wait(0.2)
                    continue
                end

                local root = getRoot()
                if ritualPart and root then
                    local dist = (root.Position - ritualPart.Position).Magnitude
                    local mode = normalizeMode(MovementMode)

                    if dist > 10 then
                        movementCancelled = false

                        if mode == "Legit" then
                            moveTo(ritualPart.CFrame, nil)
                        else
                            moveTo(ritualPart.CFrame, function()
                                return true
                            end)
                        end
                    end

                    task.wait(0.2)
                    AutosPaused = true

                    local Net = RS:FindFirstChild("__Net")
                    local Event = Net and Net:FindFirstChild("MainRemote")

                    if Event then
                        Event:FireServer("StartRitual")
                    end

                    AutosPaused = false
                end

                task.wait(1)
            end
        end)
    end
})

