local HttpService = game:GetService("HttpService")
local AutoSavePath = "PinguHub/NoobIncrementalAutoSave.rfld"
local ConfigFolder = "PinguHub/NoobIncremental"

if not isfolder("PinguHub") then makefolder("PinguHub") end
if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end

local function applyFlags(data)
    for flagName, value in pairs(data) do
        local element = Rayfield.Flags[flagName]
        if element then
            if type(value) == "table" then
                if #value == 0 then
                    value = ""
                elseif #value == 1 then
                    value = value[1]
                end
            end

            if element.Set then
                element:Set(value)
            elseif element.SetValue then
                element:SetValue(value)
            end
        end
    end
end

local function getConfigs()
    local files = listfiles(ConfigFolder)
    local names = {}

    for _, file in ipairs(files) do
        local clean = file:match("([^/\\]+)%.json$")
        if clean then
            table.insert(names, clean)
        end
    end

    return names
end

local ConfigDropdown = ConfigTab:CreateDropdown({
    Name = "Available Configs",
    Options = ensureNotEmpty(getConfigs()),
    CurrentOption = {},
    MultipleOptions = false,
    Callback = function() end
})

local saveName = ""

ConfigTab:CreateInput({
    Name = "Config Name",
    PlaceholderText = "Enter name",
    RemoveTextAfterFocus = false,
    Callback = function(text)
        saveName = text
    end
})

ConfigTab:CreateButton({
    Name = "Save Config",
    Callback = function()
        if saveName == "" then return end
        if not isfile(AutoSavePath) then return end

        local raw = readfile(AutoSavePath)
        local decoded = HttpService:JSONDecode(raw)

        local path = ConfigFolder .. "/" .. saveName .. ".json"
        writefile(path, HttpService:JSONEncode(decoded))

        Rayfield:Notify({ Title = "Config Saved", Content = "Saved config as " .. saveName, Duration = 5 })
        ConfigDropdown:Refresh(ensureNotEmpty(getConfigs()))
    end
})

ConfigTab:CreateButton({
    Name = "Load Selected Config",
    Callback = function()
        local selectedTable = ConfigDropdown.CurrentOption
        local selected = (type(selectedTable) == "table" and selectedTable[1]) or selectedTable

        if not selected or selected == "" or selected == "None" then return end

        local path = ConfigFolder .. "/" .. selected .. ".json"
        if isfile(path) then
            local decoded = HttpService:JSONDecode(readfile(path))
            applyFlags(decoded)
            Rayfield:Notify({ Title = "Config Loaded", Content = "Loaded " .. tostring(selected), Duration = 5 })
        end
    end
})

