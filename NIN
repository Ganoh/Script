local SelectedUpgrades = {}

local function getUpgradeBoards()
    local boards = {}
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local worldUI = pg and pg:FindFirstChild("WorldUI")
    if worldUI then
        for _, ui in ipairs(worldUI:GetChildren()) do
            if ui.Name:match("^Upgrades%.%.") then
                boards[ui.Name:gsub("Upgrades%.%.", "")] = ui
            end
        end
    end
    return boards
end

local function getUpgradeList(board)
    local list = {}
    if not board or not board:FindFirstChild("Main") or not board.Main.Visible then return list end
    for _, child in ipairs(board.Main:GetChildren()) do
        if child:IsA("Frame") and child.Visible and child.Name ~= "Filler" then
            table.insert(list, child.Name)
        end
    end
    return list
end

local function readCurrencyAmount(currencyObj)
    if not currencyObj then return 0 end
    local amtObj = currencyObj:FindFirstChild("Amount")
    local child = amtObj and (amtObj:FindFirstChild("1") or amtObj:FindFirstChildOfClass("StringValue") or amtObj:FindFirstChildOfClass("NumberValue"))
    return tonumber(child and (child.Value or child.Text)) or parseNumber(child and (child.Value or child.Text))
end

local function readUpgradeCost(upgradeUI)
    if not upgradeUI or not upgradeUI:FindFirstChild("Cost") then return 0 end
    local amtObj = upgradeUI.Cost:FindFirstChild("Amount")
    return amtObj and parseNumber(amtObj.Text) or 0
end

local function startAutoBuy(currency)
    task.spawn(function()
        local Net = RS:FindFirstChild("__Net")
        local Event = Net and Net:FindFirstChild("MainRemote")
        if not Event then return end

        while getgenv()[currency .. "_AutoBuy"] do
            task.wait(0.3)

            local selected = SelectedUpgrades[currency]
            if not selected or #selected == 0 then continue end

            local boards = getUpgradeBoards()
            local board = boards[currency]
            local currencyObj = LocalPlayer:FindFirstChild("CURRENCIES") and LocalPlayer.CURRENCIES:FindFirstChild(currency)
            local amount = readCurrencyAmount(currencyObj)

            if board and board:FindFirstChild("Main") then
                for _, upgradeName in ipairs(selected) do
                    local upgradeUI = board.Main:FindFirstChild(upgradeName)
                    if upgradeUI then
                        local cost = readUpgradeCost(upgradeUI)
                        if amount >= cost then
                            Event:FireServer("UpgradeUpgrade", currency, upgradeName)
                        end
                    end
                end
            end
        end
    end)
end

local CurrencyOrder = {
    "Oof","Rebirth","Goals","Fire","Blaze","Cash","Bread","Coin","HackPoints",
