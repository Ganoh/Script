local function refreshOreList()
    local seen, list = {}, {}
    if OresFolder then
        for _, ore in ipairs(OresFolder:GetChildren()) do
            local clean = ore.Name:match("^(.-)#?%d*$") or ore.Name
            if not seen[clean] then
                seen[clean] = true
                table.insert(list, clean)
            end
        end
    end
    OreList = list
    if OreDropdown then OreDropdown:Refresh(ensureNotEmpty(list)) end
end

local function refreshMobList()
    local seen, list = {}, {}
    if MobsFolder then
        for _, mob in ipairs(MobsFolder:GetChildren()) do
            local clean = mob.Name:match("^(.-)#?%d*$") or mob.Name
            if not seen[clean] then
                seen[clean] = true
                table.insert(list, clean)
            end
        end
    end
    MobList = list
    if MobDropdown then MobDropdown:Refresh(ensureNotEmpty(list)) end
end

local function refreshCapsuleList()
    local list, map = {}, {}
    if UIZones then
        for _, child in ipairs(UIZones:GetChildren()) do
            if child.Name:find("__Capsule") then
                local display = child.Name:gsub("__Capsule", "")
                if display == "" then display = "Default" end
                table.insert(list, display)
                map[display] = child.Name
            end
        end
    end
    capsuleOptions = list
    capsuleDisplayMap = map
    if CapsuleDropdown then CapsuleDropdown:Refresh(ensureNotEmpty(list)) end
end

local function refreshRuneList()
    local list = {}
    if RuneZones then
        for _, child in ipairs(RuneZones:GetChildren()) do
            table.insert(list, child.Name)
        end
    end
    runeOptions = list
    if RuneDropdown then RuneDropdown:Refresh(ensureNotEmpty(list)) end
end

