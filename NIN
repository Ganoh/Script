task.spawn(function()
    while task.wait(0.15) do
        if not autoTrialOn then continue end

        inTrialState = isPlayerInTrial()
        local trialsStatus = RS:FindFirstChild("TrialsStatus")
        local entryOpen = trialsStatus and trialsStatus:FindFirstChild("EntryOpen")
        local trialsRoot = getTrialsRoot()

        -- Auto Enter Trial Door
        if entryOpen and entryOpen.Value == true and not inTrialState and trialsRoot then
            local trialRoom = trialsRoot:FindFirstChild(SelectedTrialDifficulty .. "TrialRoom") 
                or trialsRoot:FindFirstChild("__Trial" .. SelectedTrialDifficulty .. "Room")
                or trialsRoot:FindFirstChild(SelectedTrialDifficulty)

            local touchPart = trialRoom and (
                trialRoom:FindFirstChild("TouchPart", true) or 
                (trialRoom:IsA("BasePart") and trialRoom) or 
                trialRoom:FindFirstChild("Handle", true)
            )

            if touchPart then
                local root = getRoot()
                if root then
                    root.CFrame = touchPart.CFrame
                end
            end
        end

        -- Inside Trial Handling
        if inTrialState then
            local trialStatusDiff = trialsStatus and trialsStatus:FindFirstChild(SelectedTrialDifficulty)
            local timeLeftObj = trialStatusDiff and trialStatusDiff:FindFirstChild("TimeLeft")
            
            if timeLeftObj and autoLeaveEnabled and timeLeftObj.Value > 0 and timeLeftObj.Value <= leaveTime then
                leaveTrial()
                repeat
                    task.wait(0.2)
                    inTrialState = isPlayerInTrial()
                until not inTrialState
                continue
            end

            local trialRoom = trialsRoot and (
                trialsRoot:FindFirstChild(SelectedTrialDifficulty .. "TrialRoom") or 
                trialsRoot:FindFirstChild("__Trial" .. SelectedTrialDifficulty .. "Room") or 
                trialsRoot:FindFirstChild(SelectedTrialDifficulty)
            )
            
            local mobsFolder = trialRoom and (
                trialRoom:FindFirstChild("Mobs") or 
                trialRoom:FindFirstChild("MobsFolder") or 
                trialRoom:FindFirstChild("Entities")
            )

            if mobsFolder then
                local root = getRoot()
                if root then
                    local closestMob = getClosest(mobsFolder, function(m)
                        return isAlive(m)
                    end)

                    if closestMob then
                        local cf = getTargetCFrame(closestMob)
                        if cf then
                            moveTo(cf, function()
                                return isAlive(closestMob)
                            end)
                            task.wait(0.1)
                        end
                    end
                end
            end
        end
    end
end)

