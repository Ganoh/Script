end

local function isPlayerInTrial()
    local hud = LocalPlayer.PlayerGui:FindFirstChild("HUD")
    local leaveButton = hud and hud:FindFirstChild("LeaveTrial", true)
    if leaveButton and leaveButton.Visible then 
        return true 
    end

    local ts = RS:FindFirstChild("TrialsStatus")
    if ts then
        local diff = ts:FindFirstChild(SelectedTrialDifficulty)
        if diff and diff:FindFirstChild("InTrial") and diff.InTrial.Value == true then
            return true
        end
    end

    return false
end

local function shouldPauseOverworld()
    return inTrialState or isPlayerInTrial()
end

local function getHP(obj)
    if not obj or not obj.Parent then return 0 end
    local ui = obj:FindFirstChild("OresTopUI") or obj:FindFirstChild("MobsTopUI") or obj:FindFirstChild("UI")
    if not ui then return 0 end
    local bar = ui:FindFirstChild("Bar")
    if not bar then return 0 end
    local hpLabel = bar:FindFirstChild("Health")
    if not hpLabel then return 0 end
    
    local raw = tostring(hpLabel.Text):gsub("%s+", ""):lower()
    local left = raw:match("^(.-)/") or raw
    return parseNumber(left)
end

local function isAlive(obj)
    return getHP(obj) > 0
end

local function leaveTrial()
    local Net = RS:FindFirstChild("__Net")
    local Event = Net and Net:FindFirstChild("MainRemote")
    if Event then
        Event:FireServer("LeaveTrial")
    end
end

local function getTargetCFrame(obj)
    if not obj then return nil end
    if obj:IsA("Model") then
        local specificPart = obj:FindFirstChild("TouchPart") or obj:FindFirstChild("Handle") or obj:FindFirstChild("HumanoidRootPart")
        if specificPart then return specificPart.CFrame end
        local ok, pivot = pcall(function() return obj:GetPivot() end)
        if ok then return pivot end
    elseif obj:IsA("BasePart") then
        return obj.CFrame
    end
    return nil
end

---------------------------------------------------------------------
-- Movement
---------------------------------------------------------------------
local function moveTo(cframe, aliveCheckFn)
    movementCancelled = false
    local mode = normalizeMode(MovementMode)
    local root = getRoot()
    local humanoid = getHumanoid()
    if not root or not humanoid or not cframe then return end

    if mode == "Teleport" then
        root.CFrame = cframe
        return
    end

    if mode == "Tween" then
        local distance = (root.Position - cframe.Position).Magnitude
        local tweenSpeed = math.max(distance / 60, 0.1)
        local tween = TweenService:Create(
            root,
            TweenInfo.new(tweenSpeed, Enum.EasingStyle.Linear),
            { CFrame = cframe }
        )
        tween:Play()
        while tween.PlaybackState == Enum.PlaybackState.Playing do
            if movementCancelled or (not inTrialState and shouldPauseOverworld()) or (aliveCheckFn and not aliveCheckFn()) then
                tween:Cancel()
                break
            end
            task.wait(0.05)
        end
        return
    end

    -- Walk / Legit
    local targetPos = cframe.Position
    humanoid:MoveTo(targetPos)
    local reached = false
    local connection
    connection = humanoid.MoveToFinished:Connect(function(status)
        reached = true
    end)

    local lastPos = root.Position
    local stuckTimer = 0

    while not reached do
        task.wait(0.05)
        if movementCancelled or (not inTrialState and shouldPauseOverworld()) then
            if connection then connection:Disconnect() end
            return
        end
        if aliveCheckFn and not aliveCheckFn() then
            if connection then connection:Disconnect() end
            return
        end

        local currentPos = root.Position
        local distMoved = (currentPos - lastPos).Magnitude
        lastPos = currentPos

        if distMoved < 0.05 then
            stuckTimer = stuckTimer + 0.05
        else
            stuckTimer = 0
        end

        if stuckTimer > 0.6 then
            humanoid.Jump = true
            humanoid:MoveTo(targetPos)
            stuckTimer = 0
        end

        if stuckTimer > 1.2 then
            root.CFrame = cframe + Vector3.new(0, 0.3, 0)
            break
        end
    end

    if connection then connection:Disconnect() end
end

local function getClosest(folder, filterFn)
    local root = getRoot()
    if not root or not folder then return nil end

    local best, bestDist

    for _, obj in ipairs(folder:GetChildren()) do
        if filterFn(obj) then
            local cf = getTargetCFrame(obj)
            if cf then
                local dist = (root.Position - cf.Position).Magnitude
                if not bestDist or dist < bestDist then
                    bestDist = dist
                    best = obj
                end
            end
        end
    end

    return best
end

